# Copy to .env.local for `vercel dev` or set in Vercel → Settings → Environment Variables.
# INTERVALS_* and AI_* stay server-only. PUBLIC_API_TOKEN is the only value duplicated in the
# GitHub Pages frontend (site gate — not your intervals.icu key).

# Gate token: same string in metricsintervals.html PUBLIC_API_TOKEN (if you enable the gate)
PUBLIC_API_TOKEN=

# intervals.icu (same auth as direct API: Basic API_KEY:<key>)
INTERVALS_API_KEY=
# Athlete id segment in URL, or 0 for the account that owns the API key
INTERVALS_ATHLETE_ID=0

# Optional tuning for GET /api/intervals/activities (chunk-merge for large histories)
# INTERVALS_ACTIVITIES_FETCH_LIMIT=8000
# INTERVALS_ACTIVITIES_CHUNK_DAYS=400

# OpenAI-compatible chat API (default URL is OpenRouter)
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4o-mini

# Optional: public URL for OpenRouter HTTP-Referer when VERCEL_URL is unset
# OPENROUTER_SITE_URL=https://your-domain.com
